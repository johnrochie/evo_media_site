# Copy to  docker/.env  and fill in.  `docker compose` reads it automatically.
# Changing anything here only needs `docker compose up -d` again — no rebuild.

# ── schedule ──────────────────────────────────────────────────────────────
# Cron expression for how often the full pipeline runs. Default: top of every hour.
SCHEDULE=0 * * * *
# Run one pass immediately when the scheduler container starts (0 or 1).
RUN_ON_START=0
# Timezone for the cron schedule (e.g. Europe/Dublin). Default UTC.
TZ=UTC

# ── SiteAnalyser dashboard ────────────────────────────────────────────────
# Host port for the dashboard + API. Change if 4005 is taken on your box.
SITEANALYSER_HOST_PORT=4005
# SSRF allow-list for scanning known-safe internal hosts (comma-separated).
# Leave empty in normal use.
SSRF_ALLOWED_HOSTS=

# ── Notion (CRM step) ─────────────────────────────────────────────────────
# Without these the CRM step is skipped (logged, not failed).
# Integration token: https://www.notion.so/my-integrations  (share the DB with it)
NOTION_API_KEY=
NOTION_LEADS_DATABASE_ID=

# ── search provider (optional) ────────────────────────────────────────────
# Default is the Playwright Google search. Set these to use SerpAPI instead.
LEAD_SEARCH_PROVIDER=
SERPAPI_KEY=
LEAD_LOG_LEVEL=info
